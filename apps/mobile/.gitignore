# Generated by `expo prebuild` / `expo run:ios` from `app.json` and its plugins. Regenerated,
# never edited: anything that has to be true of the native project belongs in the config, or in
# a plugin, so that the phone and CI build the same app from the same source.
/ios/
/android/
# What Gradle builds of the app's own native modules, beside their sources.
modules/*/android/build/
modules/*/android/.cxx/

.expo/
expo-env.d.ts
dist/
dist-web/
test-results/
playwright-report/
reports/
