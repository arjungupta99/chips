{
  "name": "@chipschat/web",
  "version": "1.2.3",
  "private": true,
  "description": "The Chips web client. The desktop shell and browsers load this.",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check .",
    "e2e": "playwright test",
    "journeys": "playwright test -c playwright.journeys.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "visual": "playwright test --config playwright.visual.config.ts",
    "visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@chipschat/core": "workspace:*",
    "@chipschat/protocol": "workspace:*",
    "@chipschat/ui": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@chipschat/harness": "workspace:*",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "lighthouse": "13.4.1",
    "puppeteer-core": "25.10.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
