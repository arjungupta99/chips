{
  "name": "@chipschat/tunnel",
  "version": "0.0.0",
  "private": true,
  "description": "The end-to-end tunnel between a phone and its server: a Noise NK handshake over WebCrypto, requests and sockets as messages inside it, and both ends of the relay's conversation.",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "dependencies": {
    "@chipschat/protocol": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "vitest": "4.1.11"
  }
}
