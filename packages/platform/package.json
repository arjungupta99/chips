{
  "name": "@chipschat/platform",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-cutting primitives: typed configuration, logging, metrics, ids and the clock.",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "vitest": "4.1.11"
  }
}
