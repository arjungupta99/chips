{
  "name": "@chipschat/subtle",
  "version": "0.0.0",
  "private": true,
  "description": "The subset of WebCrypto Chips needs, in JavaScript: X25519, Ed25519, AES-GCM, HMAC and SHA-256 behind the same interface, for a runtime that has no crypto.subtle of its own.",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "vitest": "4.1.11"
  }
}
